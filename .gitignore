node_modules
dist
.env
*.local

# TypeScript incremental build cache (tsc -b), regenerated on every build.
*.tsbuildinfo

# Per-developer tool permissions; .claude/launch.json IS shared.
.claude/settings.local.json

# Generated by scripts/build-articles.mjs from content/articles/*.md — the
# Markdown source is committed; the built HTML + sitemap are regenerated at
# build time (npm run build), so they're artifacts, not source.
public/articles/
public/help/
public/sitemap.xml
public/sitemap-help.xml

# inbox/ — local staging for article drafts & instructions. Everything dropped
# here is private/uncommitted; only the README (the workflow guide) is tracked.
inbox/*
!inbox/README.md
